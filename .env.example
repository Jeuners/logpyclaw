# LogpyClaw v3 — Konfiguration
# Kopiere diese Datei nach .env und passe die Werte an.

# ── LLM ───────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Storage ────────────────────────────────────────────────────────────────────
# SQLite-Pfad (relativ zum Projektverzeichnis)
DB_URL=sqlite:///./logpyclaw.db
# Für In-Memory (kein Persist):
# DB_URL=sqlite:///:memory:

# ── Auth ───────────────────────────────────────────────────────────────────────
# Token für /ext/dilles/v1/* (leer = kein Auth)
WEB_BRIDGE_TOKEN=

# ── Martin QC ─────────────────────────────────────────────────────────────────
MARTIN_QC_ENABLED=true
MARTIN_QC_MIN_SCORE=7
MARTIN_QC_MAX_RETRIES=2
# Auditor-Agent-ID für QC-Loop (leer = QC deaktiviert)
MARTIN_QC_AUDITOR_ID=

# Aktionslatenzen: letzte 64 Versuche pro Agent/Konfiguration, prozesslokal.
LATENCY_MAX_AGE_S=1800
LATENCY_MIN_SAMPLES=3
# Opt-in: lokale Entwicklung kann den Block aktivieren; False entfernt den Latenzblock.
MARTIN_LATENCY_CONTEXT_ENABLED=false
MARTIN_LATENCY_CONTEXT_MAX_CHARS=2400

# Deploy-Ziel für den deploy-Skill (rsync via SSH)
DEPLOY_SSH_HOST=user@your-server.example
DEPLOY_REMOTE_ROOT=/var/www/your-site
DEPLOY_PUBLIC_BASE=https://your-site.example
# WhatsApp Standard-Gruppe für den whatsapp-Skill
WHATSAPP_DEFAULT_GROUP=

# ── Skills ────────────────────────────────────────────────────────────────────
# ComfyUI Server (default 127.0.0.1:8000; leer = default)

COMFYUI_URL=http://127.0.0.1:8000
# ── ARD Publisher (Agentic Resource Discovery v0.9 Draft) ─────────────────────
# Wenn aktiv, wird /.well-known/ai-catalog.json mit allen externen Agenten + Skills
# serviert (ard-spec https://github.com/ards-project/ard-spec §6.1).
ARD_PUBLISHER_ENABLED=true
# FQDN für die urn:air:<publisher> NSS (ard-spec §4.2.1 verlangt FQDN).
ARD_PUBLISHER_DOMAIN=logpyclaw.local
ARD_PUBLISHER_NAME=LogpyClaw
